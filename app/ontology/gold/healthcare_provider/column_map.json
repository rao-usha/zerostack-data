    "bed_cnt": {"in_universe": true, "class": "Hospital", "transform": "cast_int", "fhir": ["Location.extension"], "omop": [], "match": "related",
                "notes": "CQ20 (beds)."},
    "tot_charges": {"in_universe": true, "class": "CostReport", "semantic_type": "amount_usd", "transform": "cast_numeric", "fhir": [], "omop": [], "match": "none"},
