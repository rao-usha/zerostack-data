    "county": {"in_universe": true, "class": "Location", "transform": "trim",
               "fhir": ["Location.address.district"], "omop": ["LOCATION.county"], "match": "exact", "notes": "NULL on every live row (BUG-CMS-HOSP-GEO)."},
    "hospital_type": {"in_universe": true, "class": "Hospital", "transform": "none", "vocabulary": "CMS_HOSPITAL_TYPE",
                      "fhir": ["Organization.type"], "omop": ["CARE_SITE.place_of_service_source_value"], "match": "close"},
    "ownership": {"in_universe": true, "class": "Hospital", "transform": "none", "vocabulary": "CMS_OWNERSHIP",
                  "fhir": [], "omop": [], "match": "none", "notes": "Coarse ownership category; local extension (owners are post-NEED)."},
    "emergency_services": {"in_universe": true, "class": "Hospital", "transform": "none",
                           "fhir": ["HealthcareService.category"], "omop": [], "match": "related",
                           "notes": "True -> a HealthcareService of category emergency (Plan-Net)."},
    "overall_rating": {"in_universe": true, "class": "HospitalQuality", "transform": "cast_int",
                       "fhir": ["MeasureReport.group.measureScore"], "omop": [], "match": "close"},
    "mortality_rating": {"in_universe": true, "class": "HospitalQuality", "transform": "none",
                         "fhir": ["MeasureReport.group.measureScore"], "omop": [], "match": "related", "notes": "Comparison text, not a score."},
    "readmission_rating": {"in_universe": true, "class": "HospitalQuality", "transform": "none",
                           "fhir": ["MeasureReport.group.measureScore"], "omop": [], "match": "related"},
    "patient_experience_rating": {"in_universe": true, "class": "HospitalQuality", "transform": "none",
                                  "fhir": ["MeasureReport.group.measureScore"], "omop": [], "match": "related"},
    "effectiveness_rating": {"in_universe": true, "class": "HospitalQuality", "transform": "none",
                             "fhir": ["MeasureReport.group.measureScore"], "omop": [], "match": "related"},
    "timeliness_rating": {"in_universe": true, "class": "HospitalQuality", "transform": "none",
                          "fhir": ["MeasureReport.group.measureScore"], "omop": [], "match": "related"},
    "imaging_rating": {"in_universe": true, "class": "HospitalQuality", "transform": "none",
                       "fhir": ["MeasureReport.group.measureScore"], "omop": [], "match": "related"}
   }
  },
  "cms_hospital_cost_reports": {
