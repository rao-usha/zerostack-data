{
 "domain": "healthcare_provider",
 "version": "hc-gold-v1",
 "created": "2026-10-08",
 "spec": "SPEC_162",
 "standards": {"fhir": "FHIR R4 (4.0.1), US Core / Plan-Net where noted", "omop": "OMOP CDM 5.4"},
 "notation": {
  "fhir": "Resource or Resource.element (Appendix A). A ':' suffix names a slice or extension.",
  "omop": "TABLE or TABLE.field (CDM 5.4 Field_Level).",
  "class": "Ontology class the column is a property of (Practitioner, Organization, Location, PractitionerRole, ServiceUtilization, Hospital, HospitalQuality, CostReport). 'Practitioner|Organization' = by entity_type.",
  "in_universe": "Counted in the R1(a) column universe. False = ingestion, surrogate-id or timestamp column (plan §6).",
  "match": "SKOS-style strength of the FHIR/OMOP mapping: exact, close, broad, narrow, related; 'none' = no standard element (local extension).",
  "transform": "Appendix A enum: how a binding reads the column."
 },
 "universe_rule": "All columns of the four bundle tables minus ingestion, surrogate-id and timestamp columns. cms_hospital_cost_reports is schema_only (every data column NULL): excluded from the weighted denominator, stated, not weighted 0.",
 "tables": {
  "nppes_providers": {
   "key": ["npi"],
   "class": "Practitioner (entity_type 1) | Organization (entity_type 2)",
   "schema_only": false,
   "columns": {
    "npi": {"in_universe": true, "class": "Practitioner|Organization", "semantic_type": "npi", "transform": "none", "is_identifier": true,
            "fhir": ["Practitioner.identifier", "Organization.identifier"], "omop": ["PROVIDER.npi", "CARE_SITE.care_site_source_value"], "match": "exact",
            "notes": "identifier.system http://hl7.org/fhir/sid/us-npi. OMOP CARE_SITE has no npi field."},
    "entity_type": {"in_universe": true, "class": "Practitioner|Organization", "transform": "none", "vocabulary": "NPPES_ENTITY_TYPE",
                    "fhir": [], "omop": [], "match": "none", "notes": "Discriminator: 1 -> Practitioner / PROVIDER, 2 -> Organization / CARE_SITE (R1(b) value coverage)."},
    "legal_name": {"in_universe": true, "class": "Practitioner|Organization", "transform": "trim",
                   "fhir": ["Organization.name", "Practitioner.name.text"], "omop": ["CARE_SITE.care_site_name", "PROVIDER.provider_name"], "match": "exact"},
    "first_name": {"in_universe": true, "class": "Practitioner", "transform": "trim",
                   "fhir": ["Practitioner.name.given"], "omop": ["PROVIDER.provider_name"], "match": "close"},
    "last_name": {"in_universe": true, "class": "Practitioner", "transform": "trim",
                  "fhir": ["Practitioner.name.family"], "omop": ["PROVIDER.provider_name"], "match": "close"},
    "credential": {"in_universe": true, "class": "Practitioner", "transform": "trim",
                   "fhir": ["Practitioner.qualification.code"], "omop": [], "match": "close", "notes": "Free text, not a coded qualification."},
    "dba_name": {"in_universe": true, "class": "Organization", "transform": "trim",
                 "fhir": ["Organization.alias"], "omop": [], "match": "exact"},
    "gender": {"in_universe": true, "class": "Practitioner", "transform": "upper",
               "fhir": ["Practitioner.gender"], "omop": ["PROVIDER.gender_source_value"], "match": "exact"},
    "practice_address_line1": {"in_universe": true, "class": "Location", "transform": "trim",
                               "fhir": ["Location.address.line"], "omop": ["LOCATION.address_1"], "match": "exact"},
    "practice_address_line2": {"in_universe": true, "class": "Location", "transform": "trim",
                               "fhir": ["Location.address.line"], "omop": ["LOCATION.address_2"], "match": "exact"},
    "practice_city": {"in_universe": true, "class": "Location", "transform": "trim",
                      "fhir": ["Location.address.city"], "omop": ["LOCATION.city"], "match": "exact"},
    "practice_state": {"in_universe": true, "class": "Location", "semantic_type": "us_state", "transform": "upper", "vocabulary": "US_STATE",
                       "fhir": ["Location.address.state"], "omop": ["LOCATION.state"], "match": "exact"},
    "practice_zip": {"in_universe": true, "class": "Location", "semantic_type": "zip5", "transform": "zip5",
                     "fhir": ["Location.address.postalCode"], "omop": ["LOCATION.zip"], "match": "exact"},
    "practice_phone": {"in_universe": true, "class": "Location", "transform": "none",
                       "fhir": ["Location.telecom", "PractitionerRole.telecom"], "omop": [], "match": "close"},
    "practice_fax": {"in_universe": true, "class": "Location", "transform": "none",
                     "fhir": ["Location.telecom"], "omop": [], "match": "close"},
    "mailing_address_line1": {"in_universe": true, "class": "Practitioner|Organization", "transform": "trim",
                              "fhir": ["Practitioner.address.line", "Organization.address.line"], "omop": [], "match": "close", "notes": "address.type = postal."},
    "mailing_address_line2": {"in_universe": true, "class": "Practitioner|Organization", "transform": "trim",
                              "fhir": ["Practitioner.address.line", "Organization.address.line"], "omop": [], "match": "close"},
    "mailing_city": {"in_universe": true, "class": "Practitioner|Organization", "transform": "trim",
                     "fhir": ["Practitioner.address.city", "Organization.address.city"], "omop": [], "match": "close"},
    "mailing_state": {"in_universe": true, "class": "Practitioner|Organization", "semantic_type": "us_state", "transform": "upper", "vocabulary": "US_STATE",
                      "fhir": ["Practitioner.address.state", "Organization.address.state"], "omop": [], "match": "close"},
    "mailing_zip": {"in_universe": true, "class": "Practitioner|Organization", "semantic_type": "zip5", "transform": "zip5",
                    "fhir": ["Practitioner.address.postalCode", "Organization.address.postalCode"], "omop": [], "match": "close"},
    "taxonomy_code": {"in_universe": true, "class": "PractitionerRole", "semantic_type": "nucc_taxonomy", "transform": "upper", "vocabulary": "NUCC_TAXONOMY",
                      "fhir": ["PractitionerRole.specialty"], "omop": ["PROVIDER.specialty_source_value"], "match": "exact",
                      "notes": "Primary taxonomy only (1 of up to 15). R1(b): row- and distinct-weighted share resolving to NUCC classes."},
    "taxonomy_description": {"in_universe": true, "class": "PractitionerRole", "transform": "none", "vocabulary": "NUCC_TAXONOMY",
                             "fhir": ["PractitionerRole.specialty.text"], "omop": [], "match": "close"},
    "taxonomy_license": {"in_universe": true, "class": "Practitioner", "transform": "trim",
                         "fhir": ["Practitioner.qualification.identifier"], "omop": [], "match": "exact"},
    "taxonomy_state": {"in_universe": true, "class": "Practitioner", "semantic_type": "us_state", "transform": "upper", "vocabulary": "US_STATE",
                       "fhir": ["Practitioner.qualification.issuer"], "omop": [], "match": "close"},
    "enumeration_date": {"in_universe": true, "class": "Practitioner|Organization", "transform": "cast_date",
                         "fhir": ["Practitioner.identifier.period.start", "Organization.identifier.period.start"], "omop": [], "match": "close"},
    "last_updated": {"in_universe": true, "class": "Practitioner|Organization", "transform": "cast_date",
                     "fhir": ["Practitioner.meta.lastUpdated", "Organization.meta.lastUpdated"], "omop": [], "match": "related"},
    "status": {"in_universe": true, "class": "Practitioner|Organization", "transform": "none",
               "fhir": ["Practitioner.active", "Organization.active"], "omop": [], "match": "close", "notes": "'A' -> active=true. Every live row is 'A'."},
    "sole_proprietor": {"in_universe": true, "class": "Practitioner", "transform": "yn_to_bool",
                        "fhir": [], "omop": [], "match": "none", "notes": "No standard element; local extension."},
    "organization_subpart": {"in_universe": true, "class": "Organization", "transform": "yn_to_bool",
                             "fhir": ["Organization.partOf"], "omop": [], "match": "related", "notes": "Flag only; the parent (partOf target) is post-NEED."},
    "ingestion_timestamp": {"in_universe": false, "reason": "ingestion timestamp"}
   }
  },
  "cms_medicare_utilization": {
   "key": ["data_year", "rndrng_npi", "hcpcs_cd", "place_of_srvc"],
   "class": "ServiceUtilization (provider x HCPCS x place of service x year, aggregate)",
   "schema_only": false,
   "columns": {
    "id": {"in_universe": false, "reason": "surrogate id"},
    "ingestion_timestamp": {"in_universe": false, "reason": "ingestion timestamp"},
    "data_year": {"in_universe": true, "class": "ServiceUtilization", "transform": "cast_int",
                  "fhir": ["MeasureReport.period", "ExplanationOfBenefit.billablePeriod"], "omop": [], "match": "close"},
    "rndrng_npi": {"in_universe": true, "class": "Practitioner|Organization", "semantic_type": "npi", "transform": "none", "is_identifier": true,
                   "fhir": ["Practitioner.identifier", "ExplanationOfBenefit.careTeam.provider"], "omop": ["PROVIDER.npi"], "match": "exact",
                   "notes": "Join key to nppes_providers.npi (R1(c): share of rows that resolve)."},
    "rndrng_prvdr_last_org_name": {"in_universe": true, "class": "Practitioner|Organization", "transform": "trim",
                                   "fhir": ["Practitioner.name.family", "Organization.name"], "omop": ["PROVIDER.provider_name"], "match": "close"},
    "rndrng_prvdr_first_name": {"in_universe": true, "class": "Practitioner", "transform": "trim",
                                "fhir": ["Practitioner.name.given"], "omop": ["PROVIDER.provider_name"], "match": "close"},
    "rndrng_prvdr_mi": {"in_universe": true, "class": "Practitioner", "transform": "trim",
                        "fhir": ["Practitioner.name.given"], "omop": [], "match": "close"},
    "rndrng_prvdr_crdntls": {"in_universe": true, "class": "Practitioner", "transform": "trim",
                             "fhir": ["Practitioner.qualification.code"], "omop": [], "match": "close"},
    "rndrng_prvdr_gndr": {"in_universe": true, "class": "Practitioner", "transform": "upper",
                          "fhir": ["Practitioner.gender"], "omop": ["PROVIDER.gender_source_value"], "match": "exact"},
    "rndrng_prvdr_ent_cd": {"in_universe": true, "class": "Practitioner|Organization", "transform": "upper", "vocabulary": "NPPES_ENTITY_TYPE",
                            "fhir": [], "omop": [], "match": "none", "notes": "Discriminator: I -> Practitioner, O -> Organization."},
    "rndrng_prvdr_st1": {"in_universe": true, "class": "Location", "transform": "trim",
                         "fhir": ["Location.address.line"], "omop": ["LOCATION.address_1"], "match": "exact"},
    "rndrng_prvdr_st2": {"in_universe": true, "class": "Location", "transform": "trim",
                         "fhir": ["Location.address.line"], "omop": ["LOCATION.address_2"], "match": "exact"},
    "rndrng_prvdr_city": {"in_universe": true, "class": "Location", "transform": "trim",
                          "fhir": ["Location.address.city"], "omop": ["LOCATION.city"], "match": "exact"},
    "rndrng_prvdr_state_abrvtn": {"in_universe": true, "class": "Location", "semantic_type": "us_state", "transform": "upper", "vocabulary": "US_STATE",
                                  "fhir": ["Location.address.state"], "omop": ["LOCATION.state"], "match": "exact"},
    "rndrng_prvdr_state_fips": {"in_universe": true, "class": "Location", "semantic_type": "fips_state", "transform": "none",
                                "fhir": ["Location.address.state"], "omop": [], "match": "close", "notes": "FIPS state code, not USPS."},
    "rndrng_prvdr_zip5": {"in_universe": true, "class": "Location", "semantic_type": "zip5", "transform": "zip5",
                          "fhir": ["Location.address.postalCode"], "omop": ["LOCATION.zip"], "match": "exact"},
    "rndrng_prvdr_ruca": {"in_universe": true, "class": "Location", "transform": "none", "vocabulary": "RUCA",
                          "fhir": [], "omop": [], "match": "none", "notes": "Rural-Urban Commuting Area code; local extension."},
    "rndrng_prvdr_ruca_desc": {"in_universe": true, "class": "Location", "transform": "none", "vocabulary": "RUCA",
                               "fhir": [], "omop": [], "match": "none"},
    "rndrng_prvdr_cntry": {"in_universe": true, "class": "Location", "semantic_type": "iso_country", "transform": "upper",
                           "fhir": ["Location.address.country"], "omop": ["LOCATION.country_source_value"], "match": "exact"},
    "rndrng_prvdr_type": {"in_universe": true, "class": "PractitionerRole", "transform": "none",
                          "fhir": ["PractitionerRole.specialty"], "omop": ["PROVIDER.specialty_source_value"], "match": "close",
                          "notes": "CMS specialty from claims, not NUCC."},
    "rndrng_prvdr_mdcr_prtcptg_ind": {"in_universe": true, "class": "PractitionerRole", "transform": "yn_to_bool",
                                      "fhir": ["PractitionerRole.extension:network-reference"], "omop": [], "match": "related",
                                      "notes": "Medicare assignment (participating). Plan-Net network participation is the closest element."},
    "hcpcs_cd": {"in_universe": true, "class": "ServiceUtilization", "semantic_type": "hcpcs", "transform": "upper", "vocabulary": "HCPCS_L2",
                 "fhir": ["ExplanationOfBenefit.item.productOrService"], "omop": ["PROCEDURE_OCCURRENCE.procedure_source_value"], "match": "close",
                 "notes": "Level I codes are AMA CPT (licence guard: never enumerate)."},
    "hcpcs_desc": {"in_universe": true, "class": "ServiceUtilization", "transform": "none", "vocabulary": "CPT",
                   "fhir": ["ExplanationOfBenefit.item.productOrService.text"], "omop": [], "match": "close",
                   "notes": "AMA CPT descriptors: never leaves the database (guard 5c)."},
    "hcpcs_drug_ind": {"in_universe": true, "class": "ServiceUtilization", "transform": "yn_to_bool",
                       "fhir": [], "omop": [], "match": "none"},
    "place_of_srvc": {"in_universe": true, "class": "ServiceUtilization", "transform": "upper", "vocabulary": "CMS_POS",
                      "fhir": ["ExplanationOfBenefit.item.locationCodeableConcept"], "omop": ["CARE_SITE.place_of_service_source_value"], "match": "broad",
                      "notes": "F facility / O office: a 2-value roll-up, not the CMS POS code set."},
    "tot_benes": {"in_universe": true, "class": "ServiceUtilization", "transform": "cast_int",
                  "fhir": ["MeasureReport.group.population.count"], "omop": [], "match": "close"},
    "tot_srvcs": {"in_universe": true, "class": "ServiceUtilization", "transform": "cast_numeric",
                  "fhir": ["ExplanationOfBenefit.item.quantity", "MeasureReport.group.measureScore"], "omop": [], "match": "close"},
    "tot_bene_day_srvcs": {"in_universe": true, "class": "ServiceUtilization", "transform": "cast_int",
                           "fhir": ["MeasureReport.group.population.count"], "omop": [], "match": "related"},
    "avg_sbmtd_chrg": {"in_universe": true, "class": "ServiceUtilization", "semantic_type": "amount_usd", "transform": "cast_numeric",
                       "fhir": ["ExplanationOfBenefit.item.adjudication.amount"], "omop": ["COST.total_charge"], "match": "close",
                       "notes": "Average per service; adjudication.category = submitted."},
    "avg_mdcr_alowd_amt": {"in_universe": true, "class": "ServiceUtilization", "semantic_type": "amount_usd", "transform": "cast_numeric",
                           "fhir": ["ExplanationOfBenefit.item.adjudication.amount"], "omop": ["COST.amount_allowed"], "match": "close",
                           "notes": "adjudication.category = eligible."},
    "avg_mdcr_pymt_amt": {"in_universe": true, "class": "ServiceUtilization", "semantic_type": "amount_usd", "transform": "cast_numeric",
                          "fhir": ["ExplanationOfBenefit.item.adjudication.amount"], "omop": ["COST.paid_by_payer"], "match": "close",
                          "notes": "adjudication.category = benefit."},
    "avg_mdcr_stdzd_amt": {"in_universe": true, "class": "ServiceUtilization", "semantic_type": "amount_usd", "transform": "cast_numeric",
                           "fhir": ["ExplanationOfBenefit.item.adjudication.amount"], "omop": [], "match": "related",
                           "notes": "Geographically standardized payment; no OMOP field."}
   }
  },
  "cms_hospitals": {
   "key": ["facility_id"],
   "class": "Hospital (Organization + Location)",
   "schema_only": false,
   "columns": {
    "id": {"in_universe": false, "reason": "surrogate id"},
    "ingested_at": {"in_universe": false, "reason": "ingestion timestamp"},
    "facility_id": {"in_universe": true, "class": "Hospital", "semantic_type": "ccn", "transform": "upper", "is_identifier": true,
                    "fhir": ["Organization.identifier"], "omop": ["CARE_SITE.care_site_source_value"], "match": "exact",
                    "notes": "CCN; identifier.system http://hl7.org/fhir/sid/us-ccn (R1(c) facilities)."},
    "facility_name": {"in_universe": true, "class": "Hospital", "transform": "trim",
                      "fhir": ["Organization.name"], "omop": ["CARE_SITE.care_site_name"], "match": "exact"},
    "address": {"in_universe": true, "class": "Location", "transform": "trim",
                "fhir": ["Location.address.line"], "omop": ["LOCATION.address_1"], "match": "exact"},
    "city": {"in_universe": true, "class": "Location", "transform": "trim",
             "fhir": ["Location.address.city"], "omop": ["LOCATION.city"], "match": "exact", "notes": "NULL on every live row (BUG-CMS-HOSP-GEO)."},
    "state": {"in_universe": true, "class": "Location", "semantic_type": "us_state", "transform": "upper", "vocabulary": "US_STATE",
