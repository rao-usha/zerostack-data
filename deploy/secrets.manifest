# Secret Manager -> /opt/nexdata/app.env (SPEC_161). Read by deploy/vm-startup.sh.
#
# Format: ENV_VAR  SECRET_ID  required|optional
#   required  boot fails (stack not started) when the secret is missing or empty
#   optional  skipped when the secret does not exist
# Project: nexdata-cloud. The VM service account needs secretmanager.secretAccessor.
#
# Only variables the code reads (a Settings field in app/core/config.py or an
# os.getenv in app/) AND that are configured today. Values must be one line and
# must not contain a single quote (app.env quotes every value literally).
# Not here on purpose: GEMINI_API_KEY / XAI_API_KEY / YELP_CLIENT_ID (set on the
# laptop, read nowhere outside config and the key tester), WB_* (workbench),
# GCLOUD_ADC (the VM has no ADC file), ANTHROPIC_API_KEY and the other provider
# keys nobody has configured. Add a line here when one is provisioned.

# Database: postgresql://<user>:<password>@cloudsqlproxy:5432/nexdata
DATABASE_URL              nexdata-database-url               required
# Fernet key for stored source API keys (app/api/v1/settings.py). MUST equal the
# laptop's current DATABASE_URL string verbatim: the key was derived from it, and
# DATABASE_URL changes host on the VM (RUNBOOK "Secrets").
ENCRYPTION_KEY            nexdata-encryption-key             required
# Session tokens: same value as the laptop, or every login is invalidated.
JWT_SECRET_KEY            nexdata-jwt-secret-key             required
# SEC fair-access User-Agent, names a monitored contact (SPEC_146)
SEC_USER_AGENT            nexdata-sec-user-agent             required

# Source API keys in use
BEA_API_KEY               nexdata-bea-api-key                required
BLS_API_KEY               nexdata-bls-api-key                required
CENSUS_SURVEY_API_KEY     nexdata-census-survey-api-key      required
DATA_COMMONS_API_KEY      nexdata-data-commons-api-key       required
DATA_GOV_API              nexdata-data-gov-api               required
EIA_API_KEY               nexdata-eia-api-key                required
FRED_API_KEY              nexdata-fred-api-key               required
GOOGLE_PLACES_API_KEY     nexdata-google-places-api-key      required
KAGGLE_USERNAME           nexdata-kaggle-username            required
# Rotate before upload (PLAN_089 Phase 0)
KAGGLE_KEY                nexdata-kaggle-key                 required
NREL_API_KEY              nexdata-nrel-api-key               required
OPENAI_API_KEY            nexdata-openai-api-key             required
USDA_API_KEY              nexdata-usda-api-key               required
YELP_API_KEY              nexdata-yelp-api-key               required

# Data watchdog (SPEC_128); PLAN_089 Phase 5 verifies the heartbeat ping
ALERT_WEBHOOK_URL         nexdata-alert-webhook-url          optional
HEARTBEAT_PING_URL        nexdata-heartbeat-ping-url         optional
